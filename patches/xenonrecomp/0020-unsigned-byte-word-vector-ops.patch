diff --git a/XenonRecomp/recompiler.cpp b/XenonRecomp/recompiler.cpp
index 17da206..bc35a7c 100644
--- a/XenonRecomp/recompiler.cpp
+++ b/XenonRecomp/recompiler.cpp
@@ -2190,6 +2190,41 @@ bool Recompiler::Recompile(
         println("\tsimde_mm_store_ps({}.f32, simde_mm_max_ps(simde_mm_load_ps({}.f32), simde_mm_load_ps({}.f32)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
         break;
 
+    // patch 0020 (TU lane, 2026-11-13): vmaxub / vminub / vsubuws / vpkuhum(128) / vrlw(128), dropped before (27 sites in the
+    // TU 27 image, sub_831A7C10 and sub_831A8328). Element order follows the reversed register layout used everywhere here:
+    // element-wise forms are order-free; vpkuhum mirrors vpkuhus (vB's halfwords fill the low host bytes).
+    case PPC_INST_VMAXUB:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_max_epu8(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VMINUB:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_min_epu8(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VSUBUWS:
+        // unsigned saturating word subtract: max(a, b) - b (VSCR[SAT] is not modelled, as for the other saturating forms here)
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u32, simde_mm_sub_epi32(simde_mm_max_epu32(simde_mm_load_si128((simde__m128i*){}.u32), simde_mm_load_si128((simde__m128i*){}.u32)), simde_mm_load_si128((simde__m128i*){}.u32)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VPKUHUM:
+    case PPC_INST_VPKUHUM128:
+        for (size_t i = 0; i < 8; i++)
+        {
+            println("\t{0}.u8[{1}] = uint8_t({2}.u16[{1}]);", vTemp(), i, v(insn.operands[2]));
+            println("\t{0}.u8[{1}] = uint8_t({2}.u16[{3}]);", vTemp(), i + 8, v(insn.operands[1]), i);
+        }
+        println("\t{} = {};", v(insn.operands[0]), vTemp());
+        break;
+
+    case PPC_INST_VRLW:
+    case PPC_INST_VRLW128:
+        for (size_t i = 0; i < 4; i++)
+        {
+            println("\t{0}.u32[{1}] = ({2}.u32[{1}] << ({3}.u32[{1}] & 0x1F)) | ({2}.u32[{1}] >> ((32 - ({3}.u32[{1}] & 0x1F)) & 0x1F));", vTemp(), i, v(insn.operands[1]), v(insn.operands[2]));
+        }
+        println("\t{} = {};", v(insn.operands[0]), vTemp());
+        break;
+
     case PPC_INST_VMAXSW:
         println("\tsimde_mm_store_si128((simde__m128i*){}.u32, simde_mm_max_epi32(simde_mm_load_si128((simde__m128i*){}.u32), simde_mm_load_si128((simde__m128i*){}.u32)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
         break;
diff --git a/XenonTests/exact_vector_recompiler.cc b/XenonTests/exact_vector_recompiler.cc
index 494a6be..d82766d 100644
